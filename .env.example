# ============================================
# AWS Credentials (NUNCA commitar este arquivo!)
# ============================================
# Renomear para .env e preencher valores reais
# Este arquivo é apenas EXEMPLO

AWS_ACCESS_KEY_ID=seu_access_key_aqui
AWS_SECRET_ACCESS_KEY=seu_secret_key_aqui
AWS_REGION=us-east-1

# ============================================
# AWS Role ARNs (para OIDC/AssumeRole)
# ============================================
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions-dev
AWS_ROLE_ARN_STAGING=arn:aws:iam::123456789012:role/github-actions-staging
AWS_ROLE_ARN_PROD=arn:aws:iam::123456789012:role/github-actions-prod

# ============================================
# LocalStack (desenvolvimento local)
# ============================================
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_ACCESS_KEY=test
LOCALSTACK_SECRET_KEY=test
