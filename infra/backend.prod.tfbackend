######################################
# Terraform Backend Configuration - Production
######################################
# Usage: terraform init -backend-config=backend.prod.tfbackend
# or:    terraform init -reconfigure -backend-config=backend.prod.tfbackend

bucket         = "your-terraform-state-bucket"
key            = "aws-infra/prod/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "terraform-state-lock"
