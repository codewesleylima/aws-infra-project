name: Simple Validate (No Docker)

on:
  workflow_dispatch: {}
  push:
    branches: [develop]
    paths:
      - 'terraform/**'
      - '.github/workflows/simple-validate.yml'

permissions:
  contents: read
  pull-requests: write

defaults:
  run:
    shell: bash

env:
  TF_VERSION: "1.6.6"
  AWS_REGION: "us-east-1"

jobs:
  # ============================================
  # VALIDATION - Format and Syntax Check
  # ============================================
  validate:
    name: Validate Terraform
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Terraform Format (auto-fix)
        run: terraform fmt -recursive
        working-directory: terraform

      - name: Terraform Format Check
        run: terraform fmt -check -recursive
        working-directory: terraform

      - name: Terraform Init (dev)
        run: terraform init -backend=false
        working-directory: terraform/environments/dev

      - name: Terraform Validate
        run: terraform validate
        working-directory: terraform/environments/dev

  # ============================================
  # SECURITY SCAN - Basic IaC checks
  # ============================================
  security:
    name: Security Scan
    runs-on: ubuntu-latest
    needs: validate
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run Checkov
        uses: bridgecrewio/checkov-action@v12
        with:
          directory: terraform/
          framework: terraform
          output_format: cli
          soft_fail: true

  # ============================================
  # PLAN - Terraform Plan without AWS creds
  # ============================================
  plan:
    name: Terraform Plan (Syntax Check)
    runs-on: ubuntu-latest
    needs: [validate, security]
    strategy:
      matrix:
        environment: [dev]
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Terraform Init (no backend)
        run: terraform init -backend=false
        working-directory: terraform/environments/${{ matrix.environment }}

      - name: Terraform Plan (syntax validation only)
        run: |
          set -euo pipefail
          terraform plan -no-color -out=tfplan 2>&1 | tee plan.txt || true
          tail -n +1 plan.txt | head -n 100 > plan_short.txt
          echo "plan_output<<EOF" >> $GITHUB_OUTPUT
          cat plan_short.txt >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT
        id: plan
        working-directory: terraform/environments/${{ matrix.environment }}
        continue-on-error: true

      - name: Upload Plan
        uses: actions/upload-artifact@v4
        with:
          name: terraform-plan-${{ matrix.environment }}
          path: terraform/environments/${{ matrix.environment }}/plan.txt
          retention-days: 30

  # ============================================
  # SUMMARY - Show results
  # ============================================
  summary:
    name: Summary
    runs-on: ubuntu-latest
    needs: [validate, security, plan]
    if: always()
    steps:
      - name: Check results
        run: |
          echo "✅ Workflow completed"
          echo "  - Validate: ${{ needs.validate.result }}"
          echo "  - Security: ${{ needs.security.result }}"
          echo "  - Plan: ${{ needs.plan.result }}"
